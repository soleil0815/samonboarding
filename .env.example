# =============================================================================
# SAMONBOARDING - your settings
#
# Once:       copy this file as .env next to the docker-compose.yml and adjust the values below,
#             then:  docker compose up -d
# Changes:    after editing .env:  docker compose up -d   (the container is recreated)
# Updates:    .env belongs to you and is never overwritten. New options appear in the .env.example of the
#             current release and can be copied over if needed. Missing values have sensible defaults.
#
# Comments only on their own lines (starting with #), never after a value.
# =============================================================================

# --- Version -----------------------------------------------------------------
# Empty = always the newest version (latest).
# "2.0" = the newest 2.0.x including its security updates (no jump to 2.1 or 3.0).
# "2.0.0" = exactly this version; going back to an older version: see README, "Fixing a version and going back".
SAMONBOARDING_VERSION=

# --- Required ----------------------------------------------------------------
# DNS name of the domain
AD_DOMAIN=firma.local
# IP or name of the domain controller
AD_DC_IP=10.0.10.5
# sAMAccountName of the operator group (empty = only the built-in group "Account Operators").
# CO-ADMIN is only an example: use the name of your own group in AD.
CUSTOM_OPERATOR_GROUP=CO-ADMIN

# --- General -----------------------------------------------------------------
# Time zone for reports and mails
TZ=Europe/Berlin
# HTTPS port: https://<server>:<HTTPS_PORT>. There is no HTTP port
HTTPS_PORT=9500

# --- HTTPS certificate -------------------------------------------------------
# Your own certificate: upload it in the interface under "Certificate" (PFX or PEM, applies immediately)
# or put cert.pem and key.pem into data/tls/ and restart.
# Otherwise a self-signed one is created, for these names/IPs (comma-separated), e.g.
# TLS_HOSTNAMES=samonboarding.firma.local,10.0.10.20
TLS_HOSTNAMES=

# --- Connection to the DC ----------------------------------------------------
# true = fall back to unencrypted LDAP (port 389) if LDAPS (636) is not reachable.
# Passwords then travel over the network in plain text - only enable in an emergency. Default: false
LDAP_ALLOW_PLAIN=false
# CA file (PEM) - it must be in the data folder: data/ca.pem on the host = /app/data/ca.pem here.
# Set -> the DC's certificate is verified
# (AD_DC_IP must then be a host name matching the certificate). Empty = the certificate is trusted
LDAP_CA_FILE=

# --- Sign-in -----------------------------------------------------------------
# Sign out after this many minutes without activity
SESSION_IDLE_MINUTES=30
# Maximum length of a session in hours, even with continuous work (then sign in again)
SESSION_MAX_HOURS=12
# Failed attempts per user/IP until the lockout, and length of the lockout in minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# --- Data protection: retention in days (0 = unlimited) ----------------------
# Reports: changes
AUDIT_RETENTION_DAYS=365
# Reports: log
LOG_RETENTION_DAYS=90
# Restore entries after offboarding
OFFBOARD_RETENTION_DAYS=180

# --- Docker network ----------------------------------------------------------
# Subnet of the container's Docker network. Only change it if it overlaps with your network
DOCKER_SUBNET=172.30.80.0/24
